# Supabase Cloud Configuration (Optional)
# If left empty, the application automatically runs in offline/local mode using browser LocalStorage.
# To sync between your Mac, iPhone, and Android:
# 1. Create a free project at https://supabase.com
# 2. Run the SQL schema provided in supabase_schema.sql
# 3. Paste your project URL and anon public key below:

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
